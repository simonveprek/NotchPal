.DS_Store

# Swift
.build/
.swiftpm/
build/
*.profraw
*.xcodeproj
*.xcworkspace

# Package.resolved is deliberately NOT ignored. This is an application, not a
# library, so pinning the resolved dependency versions is what makes someone
# else's clone build the same thing yours does.

# Website (site/)
node_modules/
.next/
out/
next-env.d.ts
.vercel
*.tsbuildinfo

# Intermediate output of Scripts/make-icon.swift. AppIcon.icns and AppIcon.png
# are committed because the build script and the README need them; the iconset
# folder they are assembled from is regenerated on demand.
Resources/AppIcon.iconset/

# Backups the hook installer leaves beside the agents' config files, in case one
# is ever copied into the repo while debugging.
*.notchpal-*.bak
*.islet-*.bak
